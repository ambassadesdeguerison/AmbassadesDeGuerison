# Supabase — Project Settings > API Keys
# Clés récentes : NEXT_PUBLIC_SUPABASE_ANON_KEY = clé « publishable » (sb_publishable_…),
#                 SUPABASE_SERVICE_ROLE_KEY    = clé « secret » (sb_secret_…). Les anciennes clés eyJ… marchent aussi.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Resend
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@votredomaine.com
RESEND_ADMIN_EMAIL=admin@votredomaine.com
# Adresse qui reçoit les réponses aux e-mails (en-tête Reply-To) — facultatif
# RESEND_REPLY_TO=contact@votredomaine.com

# App — URL publique, sans « / » final. Sert aux liens des e-mails et de connexion : une mauvaise valeur casse les magic links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret de signature (preuve d'e-mail à l'inscription, billets d'envoi vidéo). 32+ caractères aléatoires :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Absent = repli sur SUPABASE_SERVICE_ROLE_KEY ; à définir pour que changer la clé Supabase n'invalide pas les liens en cours.
EMAIL_PROOF_SECRET=

# Secret des tâches planifiées (/api/cron/*). Même commande que ci-dessus. Utile seulement quand les crons sont activés.
CRON_SECRET=

# Chaîne YouTube affichée dans le bandeau (facultatif)
# NEXT_PUBLIC_YOUTUBE_CHANNEL_URL=

# Feature flags (valeurs par défaut si absentes)
# NEXT_PUBLIC_FEATURE_EMAIL_NOTIFICATIONS=true   # défaut: true
# NEXT_PUBLIC_FEATURE_PHOTOS=false               # défaut: false
# NEXT_PUBLIC_FEATURE_RATINGS=false              # défaut: false
# NEXT_PUBLIC_FEATURE_ONBOARDING_VIDEOS=false    # défaut: false

# Live signal — fenêtre d'activité autour de event_date (heures avant ET après)
NEXT_PUBLIC_LIVE_SIGNAL_WINDOW_HOURS=4

# Admin live — fenêtre de détection du live en cours (server-side uniquement)
LIVE_WINDOW_PAST_HOURS=6
LIVE_WINDOW_FUTURE_HOURS=4

# Timezone de l'administrateur (La Réunion = UTC+4, pas d'heure d'été)
NEXT_PUBLIC_ADMIN_TZ_OFFSET=+04:00

# Phase de conception uniquement — DevOverlay sur l'URL publique (à retirer au lancement, voir CLAUDE.md)
# NEXT_PUBLIC_DEV_OVERLAY=true
# DEV_OVERLAY_SECRET=   # requis dès que le DevOverlay est actif hors poste local

# Preview emails (dev uniquement)
# Active la route /dev/emails pour visualiser les 19 templates avant envoi
# Ne PAS préfixer NEXT_PUBLIC_ — cette variable doit rester server-only
# EMAIL_PREVIEW=true

# Mailhog — capture SMTP locale des e-mails envoyés en dev, sans dépendre de Resend
# ni d'adresses e-mail réelles. Dashboard : http://localhost:8025
# Lancer le serveur : npm run mailhog (ou docker compose up -d mailhog)
# USE_MAILHOG=true
# MAILHOG_SMTP_HOST=localhost   # défaut: localhost
# MAILHOG_SMTP_PORT=1025        # défaut: 1025

# pCloud — stockage provisoire des vidéos de présentation (compte dédié)
# App key / App secret : https://docs.pcloud.com/my_apps/
PCLOUD_CLIENT_ID=
PCLOUD_CLIENT_SECRET=
# Renseignés par `node scripts/pcloud-token.js` (serveur : eapi.pcloud.com = Europe, api.pcloud.com = États-Unis)
# PCLOUD_ACCESS_TOKEN=
# PCLOUD_API_HOST=
