# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Resend
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@votredomaine.com
RESEND_ADMIN_EMAIL=admin@votredomaine.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Feature flags (valeurs par défaut si absentes)
# NEXT_PUBLIC_FEATURE_EMAIL_NOTIFICATIONS=true   # défaut: true
# NEXT_PUBLIC_FEATURE_PHOTOS=false               # défaut: false
# NEXT_PUBLIC_FEATURE_RATINGS=false              # défaut: false
# NEXT_PUBLIC_FEATURE_ONBOARDING_VIDEOS=false    # défaut: false

# Live signal — fenêtre d'activité autour de event_date (heures avant ET après)
NEXT_PUBLIC_LIVE_SIGNAL_WINDOW_HOURS=4

# Admin live — fenêtre de détection du live en cours (server-side uniquement)
LIVE_WINDOW_PAST_HOURS=6
LIVE_WINDOW_FUTURE_HOURS=4

# Timezone de l'administrateur (La Réunion = UTC+4, pas d'heure d'été)
NEXT_PUBLIC_ADMIN_TZ_OFFSET=+04:00

# Preview emails (dev uniquement)
# Active la route /dev/emails pour visualiser les 19 templates avant envoi
# Ne PAS préfixer NEXT_PUBLIC_ — cette variable doit rester server-only
# EMAIL_PREVIEW=true

# Mailhog — capture SMTP locale des e-mails envoyés en dev, sans dépendre de Resend
# ni d'adresses e-mail réelles. Dashboard : http://localhost:8025
# Lancer le serveur : npm run mailhog (ou docker compose up -d mailhog)
# USE_MAILHOG=true
# MAILHOG_SMTP_HOST=localhost   # défaut: localhost
# MAILHOG_SMTP_PORT=1025        # défaut: 1025

# pCloud — stockage provisoire des vidéos de présentation (compte dédié)
# App key / App secret : https://docs.pcloud.com/my_apps/
PCLOUD_CLIENT_ID=
PCLOUD_CLIENT_SECRET=
# Renseignés par `node scripts/pcloud-token.js` (serveur : eapi.pcloud.com = Europe, api.pcloud.com = États-Unis)
# PCLOUD_ACCESS_TOKEN=
# PCLOUD_API_HOST=
